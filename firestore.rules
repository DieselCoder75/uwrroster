rules_version = '2';

// Access model: only invited users can use the app.
// An invite is a document in /coaches keyed by the user's lowercase email; role 'admin' makes them an admin.
// What a user may do in a team is kept on the team: members see it, coaches may also change it.
// Sign-in uses email links or Google accounts, so a signed-in email is always verified.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myCoachPath() {
      return /databases/$(database)/documents/coaches/$(myEmail());
    }

    function isCoach() {
      return signedIn() && exists(myCoachPath());
    }

    function isAdmin() {
      return isCoach() && get(myCoachPath()).data.role == 'admin';
    }

    function validCoach(email) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'role', 'invitedBy', 'invitedAt'])
        && d.email == email
        && d.role in ['admin', 'coach'];
    }

    match /coaches/{email} {
      // Anyone signed in may check their own invite; coaches see the whole list.
      allow get: if signedIn() && email == myEmail();
      allow read: if isCoach();
      allow create: if isAdmin() && validCoach(email);
      // Admins can't demote or remove themselves, so there is always at least one admin.
      allow update: if isAdmin() && validCoach(email)
        && (email != myEmail() || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && email != myEmail();
    }

    function validPlayer() {
      let d = request.resource.data;
      let positions = ['GK', 'DEF', 'ATT'];
      return d.firstName is string && d.firstName.size() > 0 && d.firstName.size() <= 60
        && d.lastName is string && d.lastName.size() <= 60
        && (d.number == null || (d.number is int && d.number >= 0 && d.number <= 999))
        && d.mainPosition in positions
        && d.otherPositions is list && d.otherPositions.size() <= 2
        && d.otherPositions.hasOnly(positions)
        && d.locked is bool
        && d.active is bool
        && d.captain in [null, 'captain', 'viceCaptain'];
    }

    function team(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    // Admins see and change every team. Others see the teams they are members of, and change those they coach.
    function canView(teamId) {
      return isAdmin() || (isCoach() && myEmail() in team(teamId).members);
    }

    function canCoach(teamId) {
      return isAdmin() || (isCoach() && myEmail() in team(teamId).coaches);
    }

    function validTeam() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'gameName', 'members', 'coaches', 'createdBy', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.gameName is string && d.gameName.size() <= 40
        && d.members is list && d.members.size() <= 200
        && d.coaches is list && d.members.hasAll(d.coaches);
    }

    // Banner photos live in Firestore (Cloud Storage needs the paid plan), so they must fit in one document.
    function validPhoto() {
      let d = request.resource.data;
      return d.keys().hasOnly(['large', 'small', 'type', 'width', 'height', 'focus', 'updatedBy', 'updatedAt'])
        && d.large is bytes && d.large.size() <= 600000
        && d.small is bytes && d.small.size() <= 200000
        && d.type in ['image/webp', 'image/jpeg']
        && d.focus is string && d.focus.size() <= 20;
    }

    match /teams/{teamId} {
      // Rules are not filters: a non-admin lists teams with a members array-contains query.
      allow read: if isAdmin() || (isCoach() && myEmail() in resource.data.members);
      allow create, update: if isAdmin() && validTeam();
      allow delete: if isAdmin();

      match /players/{playerId} {
        allow read: if canView(teamId);
        allow delete: if canCoach(teamId);
        allow create, update: if canCoach(teamId) && validPlayer();
      }

      match /tournaments/{rest=**} {
        allow read: if canView(teamId);
        allow write: if canCoach(teamId);
      }

      match /images/{page} {
        allow read: if canView(teamId);
        allow create, update: if isAdmin() && validPhoto();
        allow delete: if isAdmin();
      }
    }

    // Before teams: one shared pool and tournament list. Kept read-only so the first admin can copy it into
    // the default team (src/teams/migrate.ts).
    match /players/{playerId} {
      allow read: if isAdmin();
    }

    match /tournaments/{rest=**} {
      allow read: if isAdmin();
    }

    // Marks that the copy into the default team has been made.
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
