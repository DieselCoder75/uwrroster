# Copy to .env.local and fill in from Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=uwrroster.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=uwrroster
VITE_FIREBASE_STORAGE_BUCKET=uwrroster.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use local emulators (npm run emulators) instead of the real project
VITE_USE_EMULATORS=false
